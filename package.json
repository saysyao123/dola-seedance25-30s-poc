{
  "name": "dola-seedance25-30s-poc",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Chrome-extension-first POC for observing Dola Seedance 2.5 flows in the user's current Chrome session; Playwright is debug-only.",
  "scripts": {
    "debug:observe": "tsx src/cli.ts observe",
    "debug:web": "tsx src/web/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
