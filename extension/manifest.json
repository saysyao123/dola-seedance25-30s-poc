{
  "manifest_version": 3,
  "name": "Dola Seedance Inspector",
  "version": "0.3.0",
  "description": "In-page Seedance request inspector for the user's current Chrome Dola session. No separate browser profile required.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://dola.com/*",
    "https://*.dola.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://dola.com/*",
        "https://*.dola.com/*"
      ],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://dola.com/*",
        "https://*.dola.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Dola Seedance Inspector"
  }
}
